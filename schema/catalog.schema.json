{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ecos.local/schema/catalog.schema.json",
  "title": "Catálogo de Open Ecos",
  "description": "Índice generado. No se edita a mano. Lo escribe scripts/build_catalog.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "generatedAt", "datasets"],
  "properties": {
    "formatVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "status",
          "language",
          "license",
          "themes",
          "place",
          "country",
          "bbox",
          "temporal",
          "version",
          "updated",
          "previewKind",
          "path",
          "doi",
          "hasReading",
          "readingTitle",
          "cover"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "published", "example"] },
          "language": { "type": "string" },
          "license": { "type": "string" },
          "themes": { "type": "array", "items": { "type": "string" } },
          "place": { "type": "string" },
          "country": { "type": "array", "items": { "type": "string" } },
          "doi": { "type": ["string", "null"] },
          "hasReading": { "type": "boolean" },
          "readingTitle": { "type": ["string", "null"] },
          "cover": { "type": ["string", "null"] },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          },
          "temporal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end", "resolution"],
            "properties": {
              "start": { "type": "string" },
              "end": { "type": "string" },
              "resolution": { "type": "string" }
            }
          },
          "version": { "type": "string" },
          "updated": { "type": "string" },
          "previewKind": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    }
  }
}
